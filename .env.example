# =========================================================================
# VinceZone Studio - Mẫu cấu hình biến môi trường
# =========================================================================
# Sao chép tệp này thành .env và điền các khóa API tương ứng của bạn.

PORT=3300

# 1. Kilo Gateway (Được sử dụng cho Bản Web với model kilo-auto/free)
KILO_GATEWAY_API_KEY=

# 2. OpenRouter (Người dùng tự điền khóa API riêng nếu muốn sử dụng)
OPENROUTER_API_KEY=

# 3. Cloudflare Workers AI (Người dùng tự điền khóa API riêng)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 4. OpenCode (Người dùng tự điền khóa API riêng)
OPENCODE_API_KEY=
