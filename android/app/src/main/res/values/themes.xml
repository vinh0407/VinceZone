<resources>
    <!-- Base application theme -->
    <style name="Theme.VinceZone" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_400</item>
        <item name="colorSecondaryVariant">@color/purple_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorError">@color/red_500</item>
        <item name="colorOnError">@color/white</item>

        <!-- Typography -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.VinceZone.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.VinceZone.Headline2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.VinceZone.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.VinceZone.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.VinceZone.Caption</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.VinceZone.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.VinceZone.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.VinceZone.LargeComponent</item>

        <!-- Window -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- No ActionBar theme for MainActivity -->
    <style name="Theme.VinceZone.NoActionBar" parent="Theme.VinceZone">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.VinceZone.Splash" parent="Theme.VinceZone">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.VinceZone.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.VinceZone.Headline2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.VinceZone.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.VinceZone.Body2" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.VinceZone.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray_500</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.VinceZone.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.VinceZone.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.VinceZone.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.VinceZone.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.VinceZone.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/gray_700</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Card View -->
    <style name="Widget.VinceZone.CardView" parent="Widget.Material3.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Text Input Layout -->
    <style name="Widget.VinceZone.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/gray_700</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColorFocused">@color/purple_500</item>
        <item name="hintTextColor">@color/gray_500</item>
        <item name="android:textColorHint">@color/gray_500</item>
        <item name="placeholderTextColor">@color/gray_500</item>
    </style>
</resources>