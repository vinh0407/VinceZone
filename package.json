{
  "name": "vincezone-studio",
  "private": true,
  "version": "2.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 40704 --hostname 127.0.0.1",
    "build": "next build && node electron/prepare-standalone.cjs",
    "start": "next start --port 40704 --hostname 127.0.0.1",
    "desktop": "electron electron/main.cjs",
    "build:exe": "pnpm build && node electron/build-exe.cjs",
    "build:installer": "pnpm build:exe && node electron/build-installer.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.77.0",
    "monaco-editor": "0.55.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^9.0.0",
    "electron": "^35.2.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.5.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11 || ^12"
  },
  "build": {
    "appId": "com.vincezone.studio",
    "productName": "VinceZone Studio",
    "copyright": "Copyright © 2026 VinceZone",
    "directories": {
      "output": "dist",
      "buildResources": "buildResources"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app",
        "filter": "**/*"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/vincezone-logo.ico",
      "artifactName": "VinceZone-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VinceZone Studio"
    },
    "portable": {
      "artifactName": "VinceZone-Studio-${version}-${arch}-portable.${ext}"
    },
    "asar": true,
    "compression": "maximum"
  }
}
