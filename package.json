{
  "name": "vincezone",
  "version": "1.0.0",
  "description": "",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.js",
    "desktop:dist": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.vincezone.studio",
    "productName": "VinceZone Studio",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2"
  }
}
